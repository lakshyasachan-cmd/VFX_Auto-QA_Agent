# ─── Secrets & Credentials ────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ─── Git ──────────────────────────────────────────────────────────────────────
.git
.gitignore
.gitattributes

# ─── Python bytecode & caches ─────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.pytest_cache/

# ─── Test infrastructure (never ship to production) ───────────────────────────
tests/
pytest.ini
.coverage
htmlcov/

# ─── Development databases & logs ─────────────────────────────────────────────
*.db
*.sqlite
*.log

# ─── Node / Dashboard (managed separately in dashboard/Dockerfile) ────────────
dashboard/node_modules/
dashboard/.next/
dashboard/.turbo/

# ─── IDE & OS metadata ────────────────────────────────────────────────────────
.vscode/
.idea/
*.DS_Store
Thumbs.db

# ─── Documentation (not needed at runtime) ────────────────────────────────────
ARCHITECTURE.md
DEVELOPMENT_PLAN.md
DEPLOYMENT.md
