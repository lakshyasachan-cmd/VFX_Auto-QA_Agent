# =============================================================================
# VFX Mission Control — Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git. Only commit .env.example
# =============================================================================

# ─── Application Mode ────────────────────────────────────────────────────────
# Set to "production" | "staging" | "development"
APP_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Docker service name = "db")
DATABASE_URL=postgresql://vfx_user:vfx_password@db:5432/vfx_mission_control

# SQLAlchemy query logging (true | false) — keep false in production
SQL_ECHO=false

# ─── Redis ───────────────────────────────────────────────────────────────────
# Redis connection URL (Docker service name = "redis")
REDIS_URL=redis://redis:6379/0

# ─── Google Gemini API (ADK Reasoning Engine) ─────────────────────────────────
# Required to activate live Gemini reasoning instead of MockGeminiClient
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model to use for root cause reasoning
GEMINI_MODEL=gemini-2.5-flash

# ─── IBM watsonx Orchestrate ─────────────────────────────────────────────────
# Set WATSONX_MOCK=false and fill in all fields below to use live IBM watsonx.
# Get credentials from: https://cloud.ibm.com/catalog/services/watson-orchestrate
WATSONX_MOCK=false

WATSONX_API_KEY=your-watsonx-api-key-here
WATSONX_INSTANCE_URL=https://api.jp-tok.assistant.watson.cloud.ibm.com
WATSONX_SERVICE_INSTANCE_ID=your-service-instance-id-here
WATSONX_PROJECT_ID=your-project-id-here
WATSONX_SPACE_ID=your-space-id-here

# watsonx client tuning
WATSONX_TIMEOUT_SECONDS=15.0
WATSONX_MAX_RETRIES=3
WATSONX_RETRY_BACKOFF_FACTOR=0.5

# ─── VFX Platform API Keys (RBAC) ────────────────────────────────────────────
# These keys are used for X-API-Key header authentication.
# Generate strong random keys for production (e.g. openssl rand -hex 32)
VFX_ADMIN_API_KEY=REPLACE_WITH_STRONG_RANDOM_KEY
VFX_LEAD_TD_API_KEY=REPLACE_WITH_STRONG_RANDOM_KEY
VFX_TD_API_KEY=REPLACE_WITH_STRONG_RANDOM_KEY
VFX_SYSTEM_API_KEY=REPLACE_WITH_STRONG_RANDOM_KEY

# Disable auth entirely for local dev/testing only (true | false)
VFX_AUTH_DISABLED=false

# ─── PostgreSQL (Docker service "db") ─────────────────────────────────────────
# These are used by the postgres Docker container itself, must match DATABASE_URL above.
POSTGRES_USER=vfx_user
POSTGRES_PASSWORD=vfx_password
POSTGRES_DB=vfx_mission_control

# =============================================================================
# END OF CONFIG
# =============================================================================
